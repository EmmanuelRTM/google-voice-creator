# Copy to .env (never commit it) or export in your shell / MCP client config.

# Required for any tool that calls Gemini. Get one in Google AI Studio.
GEMINI_API_KEY=

# Where voice profiles (samples, consent recordings, cached consent signatures) live.
# Defaults to ~/.voice-creator
VOICE_CREATOR_DATA_DIR=

# Where rendered dialogue WAV files are written. Defaults to $VOICE_CREATOR_DATA_DIR/output
VOICE_CREATOR_OUTPUT_DIR=

# Model overrides (defaults shown)
VOICE_CREATOR_TTS_MODEL=gemini-3.8-flash-tts
VOICE_CREATOR_LIVE_MODEL=gemini-3.8-live
