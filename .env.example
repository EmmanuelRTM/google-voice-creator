# Copy to .env (never commit it) or set these in your MCP client / deployment environment.

# --- Gemini credential (server-side only; never forwarded from MCP clients) -------------
# Use an auth key (AQ....). Legacy standard keys (AIza...) stopped working in September 2026.
GEMINI_API_KEY=
# Or point at a file holding the key (chmod 600), e.g. a mounted Docker/Kubernetes secret.
GEMINI_API_KEY_FILE=

# --- Storage ------------------------------------------------------------------------------
# Voice profiles are biometric data. Defaults to ~/.voice-creator
VOICE_CREATOR_DATA_DIR=
# Local renders. Defaults to $VOICE_CREATOR_DATA_DIR/output
VOICE_CREATOR_OUTPUT_DIR=
# Confine file-path inputs to these directories (separated by ':' on macOS/Linux, ';' on Windows).
VOICE_CREATOR_ALLOWED_DIRS=

# --- Models --------------------------------------------------------------------------------
VOICE_CREATOR_TTS_MODEL=gemini-3.8-flash-tts
VOICE_CREATOR_LIVE_MODEL=gemini-3.8-live

# --- Limits --------------------------------------------------------------------------------
# Costly Gemini calls per user per minute (off for stdio, 30 for HTTP unless set).
VOICE_CREATOR_RATE_LIMIT_PER_MINUTE=

# --- Transport -----------------------------------------------------------------------------
# stdio (local clients) or http (Streamable HTTP, OAuth required)
VOICE_CREATOR_TRANSPORT=stdio
VOICE_CREATOR_HTTP_HOST=127.0.0.1
VOICE_CREATOR_HTTP_PORT=8765
VOICE_CREATOR_HTTP_PATH=/mcp

# --- OAuth 2.1 resource server (HTTP transport) ----------------------------------------------
# oauth (default) or none (only accepted on loopback, for local testing)
VOICE_CREATOR_AUTH=oauth
# Issuer of your authorization server, exactly as it appears in tokens' "iss".
VOICE_CREATOR_OAUTH_ISSUER=
# Public URL of this MCP endpoint; also the expected token audience by default.
VOICE_CREATOR_RESOURCE_URL=
VOICE_CREATOR_OAUTH_AUDIENCE=
# Optional: skip discovery by giving the JWKS URL directly.
VOICE_CREATOR_OAUTH_JWKS_URL=
# Optional: comma-separated asymmetric JWS algorithms (HS* and none are always rejected).
VOICE_CREATOR_OAUTH_ALGORITHMS=
# Optional: token claims that carry scopes (comma-separated; granted scopes are their union).
# Default "scope,scp" covers RFC 9068 ("scope") and Okta / Entra ID ("scp").
VOICE_CREATOR_OAUTH_SCOPE_CLAIMS=
# Extra Host / Origin values accepted by DNS-rebinding protection (comma-separated).
VOICE_CREATOR_ALLOWED_HOSTS=
VOICE_CREATOR_ALLOWED_ORIGINS=
VOICE_CREATOR_DOCS_URL=

# --- Examples and verification (clients of a deployed server) -----------------------------
# An access token for YOUR Voice Creator server (never the Gemini key). The remote examples
# and scripts/verify_gemini.py --mcp-url read it from the environment, never from a flag.
VOICE_CREATOR_MCP_URL=
VOICE_CREATOR_MCP_BEARER=
